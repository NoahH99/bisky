# Copy to .env and fill in. .env is gitignored.

# Discord application bot token (Developer Portal -> Bot -> Reset Token).
BISKY_DISCORD_TOKEN=

# Sync slash commands to these guilds instantly. Leave empty for a global
# sync, which can take up to an hour to appear. JSON list.
BISKY_DEV_GUILD_IDS=[]

# Users allowed to run the admin cog (!reload, !sync, ...). Setting this also
# avoids an API round-trip on every ownership check. JSON list.
BISKY_OWNER_IDS=[]

BISKY_COMMAND_PREFIX=!
BISKY_LOG_LEVEL=INFO
BISKY_LOG_FORMAT=console

# Metrics and health endpoints (/metrics, /healthz, /readyz).
BISKY_HTTP_ENABLED=true
BISKY_HTTP_PORT=8080

# Cogs are discovered from bisky.cogs automatically. Set BISKY_EXTENSIONS to a
# JSON list to override that entirely, or list module names to skip.
# BISKY_EXTENSIONS=["bisky.cogs.ping"]
BISKY_DISABLED_EXTENSIONS=[]

# Publishing the command tree costs a request against a limited daily budget.
BISKY_SYNC_COMMANDS_ON_STARTUP=true

# Warn when the event loop is stalled longer than this (seconds).
BISKY_EVENT_LOOP_LAG_WARN_SECONDS=0.5

# Host-side URL. docker-compose overrides this to point at the postgres service.
BISKY_DATABASE_URL=postgresql+asyncpg://bisky:bisky@localhost:5432/bisky
BISKY_DB_ECHO=false
BISKY_DB_POOL_SIZE=5
BISKY_DB_MAX_OVERFLOW=10
BISKY_DB_COMMAND_TIMEOUT=30.0

# Used by docker-compose.
POSTGRES_PASSWORD=bisky
POSTGRES_PORT=5432
GRAFANA_ADMIN_PASSWORD=admin
